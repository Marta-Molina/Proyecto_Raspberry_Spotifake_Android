<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TimePicker
        android:id="@+id/timePicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:timePickerMode="spinner" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Repetir estos días:"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_horizontal">

        <CheckBox android:id="@+id/cbMon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L" android:padding="0dp" android:minWidth="0dp" android:button="@null" android:background="?attr/selectableItemBackground" android:textColor="@android:color/white" android:layout_margin="4dp" android:gravity="center" android:minHeight="32dp" android:width="32dp"/>
        <CheckBox android:id="@+id/cbTue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M" android:padding="0dp" android:minWidth="0dp" android:button="@null" android:background="?attr/selectableItemBackground" android:textColor="@android:color/white" android:layout_margin="4dp" android:gravity="center" android:minHeight="32dp" android:width="32dp"/>
        <CheckBox android:id="@+id/cbWed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="X" android:padding="0dp" android:minWidth="0dp" android:button="@null" android:background="?attr/selectableItemBackground" android:textColor="@android:color/white" android:layout_margin="4dp" android:gravity="center" android:minHeight="32dp" android:width="32dp"/>
        <CheckBox android:id="@+id/cbThu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="J" android:padding="0dp" android:minWidth="0dp" android:button="@null" android:background="?attr/selectableItemBackground" android:textColor="@android:color/white" android:layout_margin="4dp" android:gravity="center" android:minHeight="32dp" android:width="32dp"/>
        <CheckBox android:id="@+id/cbFri" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="V" android:padding="0dp" android:minWidth="0dp" android:button="@null" android:background="?attr/selectableItemBackground" android:textColor="@android:color/white" android:layout_margin="4dp" android:gravity="center" android:minHeight="32dp" android:width="32dp"/>
        <CheckBox android:id="@+id/cbSat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" android:padding="0dp" android:minWidth="0dp" android:button="@null" android:background="?attr/selectableItemBackground" android:textColor="@android:color/white" android:layout_margin="4dp" android:gravity="center" android:minHeight="32dp" android:width="32dp"/>
        <CheckBox android:id="@+id/cbSun" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="D" android:padding="0dp" android:minWidth="0dp" android:button="@null" android:background="?attr/selectableItemBackground" android:textColor="@android:color/white" android:layout_margin="4dp" android:gravity="center" android:minHeight="32dp" android:width="32dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Elige una canción:"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerAlarmSong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

</LinearLayout>
